{
  "manifest_version": 3,
  "name": "FastlegeKI → PasientSky",
  "version": "1.1.0",
  "description": "Overfører notattekst fra FastlegeKI til journalfelter i PasientSky, og genererer KI-forslag til svar på e-konsultasjoner med Claude.",
  "permissions": ["storage", "activeTab", "clipboardWrite"],
  "host_permissions": [
    "*://*.fastlegen.com/*",
    "*://*.pasientsky.no/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "FastlegeKI → PasientSky"
  },
  "content_scripts": [
    {
      "matches": ["*://*.fastlegen.com/*"],
      "js": ["util.js", "source.js"],
      "css": ["ui.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.pasientsky.no/*"],
      "js": ["util.js", "destination.js", "dialog.js"],
      "css": ["ui.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
