{
  "manifest_version": 3,
  "name": "FastlegeKI → PasientSky",
  "version": "1.2.2",
  "description": "Overfører notattekst fra FastlegeKI til PasientSky, genererer KI-forslag til meldinger med Claude, og utvider hotstrings til tekst.",
  "permissions": [
    "storage",
    "activeTab",
    "clipboardWrite",
    "scripting"
  ],
  "host_permissions": [
    "*://*.fastlegen.com/*",
    "*://*.pasientsky.no/*",
    "https://api.anthropic.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "FastlegeKI → PasientSky"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.fastlegen.com/*"
      ],
      "js": [
        "util.js",
        "source.js"
      ],
      "css": [
        "ui.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.pasientsky.no/*"
      ],
      "js": [
        "util.js",
        "destination.js",
        "dialog.js"
      ],
      "css": [
        "ui.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
